<!--
  Active terrain pointer. A user model includes this file at root level (see
  docs/project-layout.md for the expected directory layout). In turn it chains:

    1. ../terrain_style.xml     : shared style (skybox, materials, haze, lights)
    2. ../terrain/default.xml   : currently-active terrain content

  Out of the box the second line points at the shipped default terrain
  (terrain/default.xml) so a model loads with a simple flat ground even when
  nothing has been generated. Running `myoassist-terrains build` with the
  activate flag (or set-active NAME) rewrites that line to a generated
  terrain/<name>.xml; `set-active default` restores this default.

  Path note: MuJoCo resolves nested includes relative to the TOP-LEVEL model
  file's directory, not relative to this file. The "../" prefix climbs out of the
  model directory before descending again. If your model files live at a different
  depth, adjust the prefix.
-->

<mujocoinclude>
    <include file="../terrain_style.xml"/>
    <include file="../terrain/default.xml"/>
</mujocoinclude>
